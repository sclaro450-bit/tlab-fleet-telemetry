HOST=0.0.0.0
PORT=443
STATUS_PORT=8080
LOG_LEVEL=info
TELEMETRY_NAMESPACE=tesla_telemetry
# Used by the Vercel control plane to verify the persistent Railway listener.
TELEMETRY_ENDPOINT=telemetry.tlabcontrol.com:37532
TLS_ENABLED=true
TLS_CERT_PATH=/run/secrets/tls.crt
TLS_KEY_PATH=/run/secrets/tls.key
# Railway can alternatively inject the PEM values directly as secret variables.
TLS_CERT_PEM=
TLS_KEY_PEM=
ACME_DOMAIN=
ACME_EMAIL=
CLOUDFLARE_API_TOKEN=
ACME_STORAGE_PATH=/data/certmagic
# Optional additional client CA bundle. Tesla production CAs are embedded.
TLS_CA_PATH=
# Railway Vehicle Command Proxy (never commit the real values)
PROXY_DOMAIN=commands.example.com
ACME_EMAIL=admin@example.com
TESLA_PRIVATE_KEY_B64=
TESLA_PUBLIC_KEY_URL=https://example.com/.well-known/appspecific/com.tesla.3p.public-key.pem
TESLA_HTTP_PROXY_PORT=4443
