HOST=0.0.0.0
PORT=443
STATUS_PORT=8080
LOG_LEVEL=info
TELEMETRY_NAMESPACE=tesla_telemetry
TLS_ENABLED=true
TLS_CERT_PATH=/run/secrets/tls.crt
TLS_KEY_PATH=/run/secrets/tls.key
# Railway can alternatively inject the PEM values directly as secret variables.
TLS_CERT_PEM=
TLS_KEY_PEM=
# Optional additional client CA bundle. Tesla production CAs are embedded.
TLS_CA_PATH=
