# Tesla Fleet Telemetry requires a persistent, direct mTLS WebSocket listener.
# Deploy this file as a long-running Railway service with a TCP/custom domain.
FROM golang:1.26-bookworm AS build

WORKDIR /build
RUN wget -q https://github.com/jedisct1/libsodium/releases/download/1.0.19-RELEASE/libsodium-1.0.19.tar.gz \
    && tar -xzf libsodium-1.0.19.tar.gz \
    && cd libsodium-stable \
    && ./configure --disable-shared --enable-static \
    && make -j"$(nproc)" \
    && make install

RUN wget -q https://github.com/zeromq/libzmq/releases/download/v4.3.5/zeromq-4.3.5.tar.gz \
    && tar -xzf zeromq-4.3.5.tar.gz \
    && cd zeromq-4.3.5 \
    && ./configure --enable-static --disable-shared --disable-Werror \
    && make -j"$(nproc)" \
    && make install

WORKDIR /go/src/fleet-telemetry
COPY . .

ENV CGO_ENABLED=1
ENV CGO_LDFLAGS="-lstdc++"

RUN make build
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /go/bin/healthcheck ./cmd/healthcheck
RUN mkdir -p /tmp/acme-storage && touch /tmp/acme-storage/.keep

FROM gcr.io/distroless/cc-debian12:nonroot
WORKDIR /

COPY --from=build --chown=nonroot:nonroot /go/bin/fleet-telemetry /fleet-telemetry
COPY --from=build --chown=nonroot:nonroot /go/bin/healthcheck /healthcheck
COPY --from=build --chown=nonroot:nonroot /go/src/fleet-telemetry/config/config.json /etc/fleet-telemetry/config.json
COPY --from=build --chown=nonroot:nonroot /tmp/acme-storage /data/certmagic

EXPOSE 443 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["/healthcheck"]

ENTRYPOINT ["/fleet-telemetry"]
CMD ["-config=/etc/fleet-telemetry/config.json"]
